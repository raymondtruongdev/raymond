---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.png';
---

<div class="portrait">
	<div class="frame">
		<Image
			src={avatar}
			width={587}
			height={587}
			alt="Chân dung Raymond Truong, kỹ sư phần mềm, trên nền họa tiết mạch điện tử"
			loading="eager"
			fetchpriority="high"
		/>
	</div>
</div>
