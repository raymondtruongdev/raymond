---
import { formatDate, getPosts } from '../../lib/posts';
import { url } from '../../lib/url';
import Icon from './Icon.astro';

const posts = (await getPosts()).slice(0, 3);
---

<section class="section" id="blog" aria-labelledby="h-blog">
	<div class="sec-head reveal">
		<div>
			<p class="sec-num">04 <span>— Blog</span></p>
			<h2 id="h-blog">Bài viết mới</h2>
		</div>
		<a class="link-more" href={url('blog/')}>Xem tất cả <Icon name="arrow" /></a>
	</div>
	<div class="posts">
		{
			posts.map((post) => (
				<a class="post reveal" href={url(`blog/${post.id}/`)}>
					<div class="post-meta">
						<span class="post-tag">{post.data.category}</span>
						<time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
					</div>
					<h3>{post.data.title}</h3>
					<p>{post.data.description}</p>
					<span class="read">
						Đọc tiếp <Icon name="arrow" />
					</span>
				</a>
			))
		}
	</div>
</section>
