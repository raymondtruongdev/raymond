---
// Breadcrumb, mục lục thu gọn (màn hình hẹp), eyebrow, tiêu đề và dòng thông tin
import { url } from '../../lib/url';
import Icon from './Icon.astro';

const { sidebar, toc, entry, lastUpdated } = Astro.locals.starlightRoute;

type Entry = (typeof sidebar)[number];
const findTrail = (entries: Entry[]): string[] | undefined => {
	for (const item of entries) {
		if (item.type === 'link') {
			if (item.isCurrent) return [item.label];
		} else {
			const rest = findTrail(item.entries);
			if (rest) return [item.label, ...rest];
		}
	}
};
const trail = findTrail(sidebar) ?? [entry.data.title];
const group = trail.length > 1 ? trail[0] : undefined;

// Bỏ mục "Tổng quan" do Starlight tự thêm
const headings = (toc?.items ?? []).flatMap((item) => (item.slug === '_top' ? item.children : [item]));

// Bài nhúng HTML không có nội dung chữ để ước lượng thời gian đọc
const body = entry.body ?? '';
const minutes = body.includes('lesson-frame') ? 0 : Math.max(1, Math.round(body.split(/\s+/).length / 220));
---

<nav class="crumbs" aria-label="Breadcrumb">
	<a href={url('docs/')}>Docs</a>
	{
		trail.map((label, i) => (
			<>
				<span class="sep" aria-hidden="true">/</span>
				<span aria-current={i === trail.length - 1 ? 'page' : undefined}>{label}</span>
			</>
		))
	}
</nav>

{
	headings.length > 0 && (
		<details class="page-toc">
			<summary>{Astro.locals.t('tableOfContents.onThisPage')}</summary>
			<ul>
				{headings.map((item) => (
					<li>
						<a href={`#${item.slug}`}>{item.text}</a>
						{item.children.length > 0 && (
							<ul>
								{item.children.map((child) => (
									<li>
										<a href={`#${child.slug}`}>{child.text}</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
		</details>
	)
}

{
	group && (
		<div class="eyebrow">
			<span class="dot" />
			{group}
		</div>
	)
}

<h1 id="_top">{entry.data.title}</h1>

{
	(minutes > 0 || lastUpdated) && (
		<div class="meta">
			{minutes > 0 && (
				<span>
					<Icon name="clock" />
					{minutes} phút đọc
				</span>
			)}
			{lastUpdated && (
				<span>
					<Icon name="cal" />
					Cập nhật {lastUpdated.toLocaleDateString('vi-VN', { timeZone: 'UTC' })}
				</span>
			)}
		</div>
	)
}

<script>
	// Đóng mục lục sau khi chọn một mục
	const toc = document.querySelector<HTMLDetailsElement>('.page-toc');
	toc?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (toc.open = false)));

	// Tô kiểu cho số "1." và chữ "A." gõ sẵn ở đầu tiêu đề. Chữ không đổi nên link #... giữ nguyên.
	document.querySelectorAll('.sl-markdown-content :is(h2, h3)').forEach((heading) => {
		const text = heading.firstChild;
		if (!(text instanceof Text)) return;
		const match = text.data.match(/^(\d+ & \d+\.|(?:\d+\.)+\d*|[A-Z]\.)(?=\s)/);
		if (!match) return;
		const mark = document.createElement('span');
		mark.className = /^[A-Z]/.test(match[0]) ? 'letter' : 'num';
		// Ô số / chữ chỉ hiện "1", "A"; dấu chấm vẫn còn trong nội dung
		const dot = document.createElement('span');
		dot.className = 'dot-hidden';
		dot.textContent = '.';
		mark.replaceChildren(match[0].slice(0, -1), dot);
		text.data = text.data.slice(match[0].length);
		heading.prepend(mark);
	});
</script>
