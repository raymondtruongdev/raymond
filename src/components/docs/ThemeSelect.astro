---
// Segmented control Sáng / Tối / Hệ thống. Dùng key `starlight-theme` của Starlight.
import Icon from './Icon.astro';

const options = [
	{ value: 'light', label: 'Sáng', icon: 'sun' },
	{ value: 'dark', label: 'Tối', icon: 'moon' },
	{ value: 'auto', label: 'Hệ thống', icon: 'sys' },
] as const;
---

<raymond-theme-select class="seg" role="group" aria-label="Giao diện">
	{
		options.map((option) => (
			<button type="button" data-set={option.value} aria-pressed="false" title={option.label} aria-label={option.label}>
				<Icon name={option.icon} />
				<span>{option.label}</span>
			</button>
		))
	}
</raymond-theme-select>

<script>
	type Pref = 'light' | 'dark' | 'auto';
	const system = matchMedia('(prefers-color-scheme: light)');

	const load = (): Pref => {
		try {
			const saved = localStorage.getItem('starlight-theme');
			return saved === 'light' || saved === 'dark' ? saved : 'auto';
		} catch {
			return 'auto';
		}
	};

	// Nút xuất hiện hai lần (thanh trên và menu ☰) nên cập nhật tất cả
	const apply = (pref: Pref) => {
		document.documentElement.dataset.theme = pref === 'auto' ? (system.matches ? 'light' : 'dark') : pref;
		document
			.querySelectorAll<HTMLButtonElement>('raymond-theme-select button')
			.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.set === pref)));
	};

	let current = load();

	customElements.define(
		'raymond-theme-select',
		class extends HTMLElement {
			connectedCallback() {
				apply(current);
				this.addEventListener('click', (event) => {
					const button = (event.target as Element).closest('button');
					if (!button) return;
					current = button.dataset.set as Pref;
					apply(current);
					try {
						localStorage.setItem('starlight-theme', current === 'auto' ? '' : current);
						// `theme` dùng chung với trang chủ và Blog
						current === 'auto' ? localStorage.removeItem('theme') : localStorage.setItem('theme', current);
					} catch {}
				});
			}
		},
	);

	system.addEventListener('change', () => current === 'auto' && apply('auto'));
</script>
