---
import PostCard from '../components/PostCard.astro';
import { education, experiences, languages, skills } from '../data/profile';
import Layout from '../layouts/Layout.astro';
import { getPosts } from '../lib/posts';
import { url } from '../lib/url';

const posts = (await getPosts()).slice(0, 3);

const highlights = [
	{
		tag: 'Robotics + AI',
		title: 'Robot Arm kết hợp AI',
		text: 'Thiết kế Robot Arm kết hợp AI cho các tác vụ tự động hóa công nghiệp và gia dụng.',
	},
	{
		tag: 'Embedded',
		title: 'Hệ thống RTOS đa thiết bị',
		text: 'Xây dựng hệ thống RTOS đa thiết bị với cấu trúc base code đồng nhất.',
	},
];

const container = 'mx-auto max-w-7xl px-4 sm:px-6 lg:px-8';
const section = 'py-8 sm:py-16 lg:py-24 scroll-mt-16';
const heading = 'text-2xl font-semibold md:text-3xl lg:text-4xl';
const card = 'bg-card ring-foreground/10 rounded-xl p-6 ring-1';
const chip = 'border-border rounded-full border px-3 py-1 text-sm';
---

<Layout title="Raymond Truong | Software Engineer">
	<section class="bg-muted pt-12 pb-12 sm:pt-16 sm:pb-16 lg:pb-24">
		<div class={`${container} flex flex-col gap-16`}>
			<div class="flex max-w-4xl flex-col items-center gap-4 self-center text-center">
				<img src={url('avatar.png')} alt="Ảnh đại diện Raymond Truong" width="128" height="128" class="size-32" />
				<span class={chip}>📍 Ho Chi Minh City</span>
				<h1 class="text-3xl leading-tight font-semibold text-balance sm:text-4xl lg:text-5xl">
					Raymond Truong, Software Engineer / Embedded Developer
				</h1>
				<p class="text-muted-foreground max-w-2xl text-lg sm:text-xl">
					Kỹ sư phần mềm chuyên sâu về Trí tuệ nhân tạo (AI) và Hệ thống nhúng (Embedded). Kinh nghiệm
					thiết kế thiết bị Tự động hóa kết hợp Machine Learning, đam mê tối ưu hiệu năng phần cứng và
					xây dựng giải pháp thông minh cho hệ sinh thái IoT.
				</p>
				<div class="flex flex-wrap justify-center gap-3">
					<a href="#contact" class="bg-primary text-primary-foreground rounded-md px-4 py-2 font-medium">Liên hệ</a>
					<a href="https://github.com/raymondtruongdev" class="border-border bg-card rounded-md border px-4 py-2 font-medium">GitHub</a>
				</div>
			</div>

			<div class="grid gap-6 sm:grid-cols-2">
				{
					highlights.map((item) => (
						<div class={`${card} flex flex-col items-start gap-3`}>
							<span class="bg-primary/10 text-primary rounded-full px-3 py-0.5 text-sm">{item.tag}</span>
							<h2 class="text-xl font-medium">{item.title}</h2>
							<p class="text-muted-foreground">{item.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="experience" class={section}>
		<div class={`${container} space-y-8`}>
			<h2 class={heading}>Kinh nghiệm làm việc</h2>
			<div class="grid gap-6 lg:grid-cols-2">
				{
					experiences.map((job) => (
						<article class={card}>
							<span class="bg-primary/10 text-primary rounded-full px-3 py-0.5 text-sm">{job.time}</span>
							<h3 class="mt-3 text-xl font-medium">{job.role}</h3>
							{job.groups.map((group) => (
								<>
									{group.title && <h4 class="text-primary mt-3 font-medium">{group.title}</h4>}
									<ul class="text-muted-foreground mt-3 list-disc space-y-2 pl-5">
										{group.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</>
							))}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="skills" class={`bg-muted ${section}`}>
		<div class={`${container} space-y-8`}>
			<h2 class={heading}>Kỹ năng và học vấn</h2>
			<div class="grid gap-6 lg:grid-cols-3">
				<div class={card}>
					<h3 class="mb-4 text-xl font-medium">Kỹ năng</h3>
					<ul class="flex flex-wrap gap-2">
						{skills.map((skill) => <li class={chip}>{skill}</li>)}
					</ul>
				</div>
				<div class={card}>
					<h3 class="mb-4 text-xl font-medium">Học vấn</h3>
					<p class="mb-4 font-medium">Ho Chi Minh City University of Technology</p>
					{
						education.map((edu) => (
							<p class="mb-3">
								{edu.degree}
								<span class="text-muted-foreground block text-sm">{edu.time}</span>
							</p>
						))
					}
				</div>
				<div class={card}>
					<h3 class="mb-4 text-xl font-medium">Ngôn ngữ</h3>
					{
						languages.map((lang) => (
							<p class="mb-2 flex justify-between gap-3">
								<span>{lang.name}</span>
								<span class="text-primary font-medium">{lang.level}</span>
							</p>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class={section}>
		<div class={`${container} space-y-8`}>
			<div class="flex flex-wrap items-end justify-between gap-3">
				<h2 class={heading}>Bài viết mới</h2>
				<a href={url('blog/')} class="text-primary font-medium">Xem tất cả →</a>
			</div>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		</div>
	</section>

	<section id="contact" class={`bg-muted ${section}`}>
		<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
			<div class={`${card} flex flex-col items-center gap-4 text-center`}>
				<h2 class="text-2xl font-semibold">Liên hệ với mình</h2>
				<p class="text-muted-foreground">Trao đổi về dự án AI, hệ thống nhúng hoặc tự động hóa.</p>
				<a href="mailto:quoctoan2202@gmail.com" class="bg-primary text-primary-foreground rounded-md px-4 py-2 font-medium break-all">
					quoctoan2202@gmail.com
				</a>
			</div>
		</div>
	</section>
</Layout>
