---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Trang cá nhân của Raymond Truong - Software Engineer / Embedded Developer.' } =
	Astro.props;

const navigation = [
	{ title: 'Trang chủ', href: url() },
	{ title: 'Lĩnh vực', href: url('#services') },
	{ title: 'Giới thiệu', href: url('#about') },
	{ title: 'Kinh nghiệm', href: url('#experience') },
	{ title: 'Blog', href: url('blog/') },
];

const round = 'border-border flex size-11 cursor-pointer items-center justify-center rounded-full border';
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<link rel="icon" href={url('favicon.ico')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@300..800&display=swap" />
		<title>{title}</title>
		<script is:inline>
			// Chạy trước khi vẽ trang để không bị nháy màu
			(() => {
				let saved;
				try {
					saved = localStorage.getItem('theme');
				} catch {}
				const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
			})();
		</script>
	</head>
	<body class="flex min-h-screen flex-col font-sans antialiased">
		<header class="bg-background/80 sticky top-0 z-50 py-4 backdrop-blur">
			<div class="relative mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 sm:px-8">
				<a href={url()} class="flex items-center gap-3">
					<span class="relative flex size-7 overflow-hidden rounded-xl">
						<span class="absolute -top-1 -right-1 size-4 rotate-45 rounded-md bg-green-500"></span>
						<span class="absolute -right-1 -bottom-1 size-4 rotate-45 rounded-md bg-[#FCDC58]"></span>
						<span class="bg-primary absolute -bottom-1 -left-1 size-4 rotate-45 rounded-md"></span>
						<span class="bg-foreground absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full"></span>
					</span>
					<span class="text-lg font-semibold">Raymond</span>
				</a>

				<nav class="flex gap-6 text-lg max-lg:hidden">
					{navigation.map((item) => <a href={item.href} class="hover:text-primary font-medium transition">{item.title}</a>)}
				</nav>

				<div class="flex items-center gap-3">
					<a href={url('#contact')} class="bg-primary text-primary-foreground rounded-full px-6 py-3 font-medium transition hover:bg-[#172554] max-sm:hidden">
						Liên hệ
					</a>
					<button id="theme-toggle" type="button" class={round} aria-label="Chuyển chế độ sáng / tối">
						<span class="dark:hidden">🌙</span>
						<span class="hidden dark:inline">☀️</span>
					</button>
					<details class="lg:hidden">
						<summary class={`${round} list-none`} aria-label="Menu">☰</summary>
						<nav class="bg-popover border-border absolute inset-x-5 top-full mt-4 flex flex-col rounded-2xl border p-3 shadow-lg">
							{navigation.map((item) => <a href={item.href} class="hover:bg-accent rounded-lg px-3 py-2 font-medium">{item.title}</a>)}
							<a href={url('#contact')} class="text-primary rounded-lg px-3 py-2 font-semibold">Liên hệ</a>
						</nav>
					</details>
				</div>
			</div>
		</header>

		<main class="flex-1 overflow-x-clip">
			<slot />
		</main>

		<footer class="mt-16 rounded-t-3xl bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-10 sm:px-8">
				<a href={url()} class="flex items-center gap-3">
					<span class="relative flex size-7 overflow-hidden rounded-xl">
						<span class="absolute -top-1 -right-1 size-4 rotate-45 rounded-md bg-green-500"></span>
						<span class="absolute -right-1 -bottom-1 size-4 rotate-45 rounded-md bg-[#FCDC58]"></span>
						<span class="bg-primary absolute -bottom-1 -left-1 size-4 rotate-45 rounded-md"></span>
						<span class="bg-foreground absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full"></span>
					</span>
					<span class="text-lg font-semibold">Raymond</span>
				</a>
				<p class="text-muted-foreground">© {new Date().getFullYear()} Raymond Truong</p>
				<a href="https://github.com/raymondtruongdev" class="hover:text-primary font-medium">GitHub</a>
			</div>
		</footer>

		<script>
			document.getElementById('theme-toggle')!.addEventListener('click', () => {
				const dark = document.documentElement.classList.toggle('dark');
				try {
					localStorage.setItem('theme', dark ? 'dark' : 'light');
				} catch {}
			});
			// Đóng menu di động sau khi chọn mục
			const menu = document.querySelector<HTMLDetailsElement>('header details');
			menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (menu.open = false)));
		</script>
	</body>
</html>
